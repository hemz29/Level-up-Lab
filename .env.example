# ---- Browser build (public values, safe to expose) ----
# From Supabase: Project Settings -> API. Leave empty to run in single-device "local mode".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Vercel serverless functions only (secret). Set in Vercel -> Settings -> Environment Variables ----
# Supabase: Project Settings -> API -> service_role key. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails that can open the admin dashboard.
ADMIN_EMAILS=
# Resend: API key and a sender on a domain you verified in Resend.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
